{
  "id": "/",
  "name": "Katoa — Sistema Administrativo",
  "short_name": "Katoa",
  "description": "Facturación, pedidos, inventario y cobros de Corporación Katoa Global.",
  "lang": "es",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#FCF8F3",
  "theme_color": "#BE6E41",
  "categories": ["business", "finance", "productivity"],
  "prefer_related_applications": false,
  "launch_handler": { "client_mode": "navigate-existing" },
  "icons": [
    { "src": "/assets/img/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/assets/img/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/assets/img/icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/assets/img/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Nueva venta",
      "short_name": "Venta",
      "url": "/assets/pages/facturacion.html",
      "icons": [{ "src": "/assets/img/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Pedidos",
      "short_name": "Pedidos",
      "url": "/assets/pages/pedidos.html",
      "icons": [{ "src": "/assets/img/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Inventario",
      "short_name": "Inventario",
      "url": "/assets/pages/inventario.html",
      "icons": [{ "src": "/assets/img/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
